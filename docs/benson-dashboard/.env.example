# Benson dashboard settings (example only — do not put real values in Git)
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=8765
HERMES_BENSON_BASE_PATH=/benson

# Trusted-LAN basic authentication. Generate the hash and secret as documented
# in website/docs/user-guide/features/web-dashboard.md.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=benson
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=scrypt$REPLACE_WITH_GENERATED_HASH
HERMES_DASHBOARD_BASIC_AUTH_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_BYTES
HERMES_DASHBOARD_BASIC_AUTH_TTL_SECONDS=43200

# Authoritative memory location (no credentials).
OBSIDIAN_VAULT_PATH=/opt/data/ObsidianMemory
